{#- One column, sober. Section order and headings come from the sampled style. -#}
{% import "_macros.html.j2" as m %}
<!doctype html>
<html lang="pt-BR"><head><meta charset="utf-8"><style>
{{ m.base_css(style) }}
h1 { font-size: 20pt; margin: 0 0 1mm; color: {{ style.accent }}; }
.contact { color: #555; margin-bottom: 4mm; }
h2 { font-size: 11.5pt; color: {{ style.accent }}; border-bottom: 1px solid {{ style.accent }};
     margin: 5mm 0 2mm; text-transform: uppercase; letter-spacing: 0.5pt; }
</style></head><body>
<h1>{{ cv.nome }}</h1>
<div class="contact">{{ m.contact(cv, fmt) }}</div>
{% for section in style.section_order if m.has(cv, style, section) == "True" %}
<h2>{{ style.headings[section] }}</h2>
{{ m.body(cv, fmt, style, section) }}
{% endfor %}
</body></html>
