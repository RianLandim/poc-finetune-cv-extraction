{#- Compact, table-based: dates in a narrow left column, details on the right. The name is
    centred above a boxed contact line. -#}
{% import "_macros.html.j2" as m %}
<!doctype html>
<html lang="pt-BR"><head><meta charset="utf-8"><style>
{{ m.base_css(style) }}
h1 { font-size: 18pt; text-align: center; margin: 0 0 2mm; letter-spacing: 1pt; }
.contact { text-align: center; border: 1px solid #999; padding: 1.5mm; margin-bottom: 4mm; font-size: 9.5pt; }
h2 { font-size: 11pt; background: #e8e8e8; color: {{ style.accent }}; padding: 1mm 2mm; margin: 4mm 0 2mm; }
table { width: 100%; border-collapse: collapse; }
td { vertical-align: top; padding: 0 0 2.5mm 0; }
td.when { width: 34mm; color: #555; font-size: 9pt; padding-right: 3mm; }
tr { page-break-inside: avoid; }
</style></head><body>
<h1>{{ cv.nome }}</h1>
<div class="contact">{{ m.contact(cv, fmt, "  |  ") }}</div>
{% for section in style.section_order if m.has(cv, style, section) == "True" %}
<h2>{{ style.headings[section] }}</h2>
{% if section == "experiencias" %}
<table>{% for e in cv.experiencias %}<tr><td class="when">{{ fmt.period(e.inicio, e.fim) }}</td><td>{{ m.experiencia(e, fmt, style, period=False) }}</td></tr>{% endfor %}</table>
{% elif section == "formacao" %}
<table>{% for f in cv.formacao %}<tr><td class="when">{{ fmt.completion(f.conclusao) }}</td><td>{{ m.formacao(f, fmt, style, period=False) }}</td></tr>{% endfor %}</table>
{% else %}
{{ m.body(cv, fmt, style, section) }}
{% endif %}
{% endfor %}
</body></html>
