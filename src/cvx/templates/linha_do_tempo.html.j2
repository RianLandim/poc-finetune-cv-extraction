{#- Timeline: start and end dates STACKED in a left gutter next to a vertical rule, so the
    model must pair "Jul 2021" with "presente" across lines that also carry the job. -#}
{% import "_macros.html.j2" as m %}
<!doctype html>
<html lang="pt-BR"><head><meta charset="utf-8"><style>
{{ m.base_css(style) }}
h1 { font-size: 21pt; margin: 0; }
.contact { margin: 1mm 0 4mm; color: #444; }
h2 { font-size: 12pt; color: {{ style.accent }}; margin: 5mm 0 2mm; }
.tl { display: grid; grid-template-columns: 22mm 1fr; }
.tl .when { text-align: right; padding-right: 3mm; color: #555; font-size: 9pt; border-right: 2px solid {{ style.accent }}; }
.tl .what { padding-left: 4mm; padding-bottom: 3mm; }
.tl .what .item { margin: 0; }
</style></head><body>
<h1>{{ cv.nome }}</h1>
<div class="contact">{{ m.contact(cv, fmt) }}</div>
{% for section in style.section_order if m.has(cv, style, section) == "True" %}
<h2>{{ style.headings[section] }}</h2>
{% if section == "experiencias" %}
<div class="tl">{% for e in cv.experiencias %}<div class="when">{{ fmt.date(e.inicio) }}<br>{{ fmt.date(e.fim) }}</div><div class="what">{{ m.experiencia(e, fmt, style, period=False) }}</div>{% endfor %}</div>
{% elif section == "formacao" %}
<div class="tl">{% for f in cv.formacao %}<div class="when">{{ fmt.completion(f.conclusao) }}</div><div class="what">{{ m.formacao(f, fmt, style, period=False) }}</div>{% endfor %}</div>
{% else %}
{{ m.body(cv, fmt, style, section) }}
{% endif %}
{% endfor %}
</body></html>
